{
  "name": "missing-mar-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "admin": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "build:art": "python3 scripts/build-hero.py && python3 scripts/build-underground.py",
